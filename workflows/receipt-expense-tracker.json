    {
      "parameters": {
        "jsCode": "const LOOKBACK_DAYS = 30;   // use 30 while testing\nconst zone = $now.zoneName;\nconst since = $now.startOf('day').minus({ days: LOOKBACK_DAYS });\n\nconst all = $input.all().map(i => i.json);\nconst needsReview = all.filter(r => r.status === 'NEEDS REVIEW').length;\n\nconst rows = all\n  .filter(r => r.status === 'OK' && r.receipt_date)\n  .map(r => ({\n    merchant: r.merchant,\n    category: r.category || 'Other',\n    amount: Number(r.total) || 0,\n    d: DateTime.fromISO(String(r.receipt_date).trim(), { zone }),\n  }))\n  .filter(r => r.d.isValid && r.d >= since);\n\nif (rows.length === 0) return [];\n\nconst byCat = {};\nlet total = 0;\nfor (const r of rows) {\n  total += r.amount;\n  byCat[r.category] = (byCat[r.category] || 0) + r.amount;\n}\nconst biggest = rows.reduce((a, b) => (b.amount > a.amount ? b : a));\n\nconst categories = Object.entries(byCat)\n  .sort((a, b) => b[1] - a[1])\n  .map(([c, v]) => `${c}: ${v.toFixed(2)}`)\n  .join('\\n');\n\nreturn [{ json: {\n  period: `${since.toISODate()} to ${$now.toISODate()}`,\n  count: rows.length,\n  total: total.toFixed(2),\n  categories,\n  biggest: `${biggest.merchant} (${biggest.amount.toFixed(2)})`,\n  needsReview,\n} }];"
      },
