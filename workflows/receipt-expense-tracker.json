    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content?.parts?.[0]?.text ?? $json.text ?? $json.output ?? '';\nconst clean = String(raw).replace(/```json|```/g, '').trim();\n\nlet p;\ntry { p = JSON.parse(clean); } catch (e) { p = {}; }\n\nconst num = (v) => (v === null || v === undefined || v === '' ? NaN : Number(v));\nconst total = num(p.total);\nconst tax = num(p.tax);\nconst dateOk = /^\\d{4}-\\d{2}-\\d{2}$/.test(p.receipt_date || '');\nconst categories = ['Meals', 'Office Supplies', 'Fuel/Transport', 'Utilities', 'Software', 'Marketing', 'Other'];\n\nconst problems = [];\nif (!p.merchant) problems.push('merchant not found');\nif (!isFinite(total) || total <= 0) problems.push('total not readable');\nif (!dateOk) problems.push('date not readable');\n\nconst mail = $('Gmail Trigger').item.json;\n\nreturn { json: {\n  receipt_date: dateOk ? p.receipt_date : '',\n  merchant: p.merchant || '',\n  total: isFinite(total) ? total : '',\n  tax: isFinite(tax) ? tax : '',\n  category: categories.includes(p.category) ? p.category : 'Other',\n  status: problems.length ? 'NEEDS REVIEW' : 'OK',\n  note: problems.join('; '),\n  email_subject: mail.subject || mail.Subject || '',\n} };"
      },
